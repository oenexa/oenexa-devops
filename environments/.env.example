# ─── 1. DOMAIN & REVERSE PROXY ────────────────────────────────────────────────
DOMAIN_NAME=localhost
PORT=80

# ─── 2. AI GATEWAY KEYS (Optional for local development / testing) ───────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434

# ─── 3. LOCAL PERSISTENCE ─────────────────────────────────────────────────────
POSTGRES_USER=oenexa
POSTGRES_PASSWORD=oenexa_dev_secret
POSTGRES_DB=oenexa_db

# ─── 4. BLOCKCHAIN NODE ───────────────────────────────────────────────────────
ONXC_PASSWORD=Kalit@Tensab!1579
ONXC_NETWORK=local-dev
ONXC_RPC_PORT=8545
ONXC_P2P_PORT=8765

# ─── 5. COMMERCE ─────────────────────────────────────────────────────────────
JWT_SECRET=local_dev_jwt_secret_0123456789abcdef0123456789abcdef
