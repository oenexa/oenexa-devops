# ==============================================================================
# OENEXA ECOSYSTEM — Production Environment Configuration
# Copy this file to .env.production: cp .env.production.example .env.production
# Protect this file on the server: chmod 600 .env.production
# ==============================================================================

# ─── 1. DOMAIN & EDGE PROXY ──────────────────────────────────────────────────
DOMAIN_NAME=oenexa.com
CADDY_LETSENCRYPT_EMAIL=ops@oenexa.com

# ─── 2. LIVE CLOUD LLM API KEYS (Provide at least one) ───────────────────────
# Anthropic Claude 3.5 Sonnet / Opus
ANTHROPIC_API_KEY=
# OpenAI GPT-4o / o3-mini
OPENAI_API_KEY=
# DeepSeek V3 / R1
DEEPSEEK_API_KEY=
# Google Gemini 2.5 Flash / Pro
GEMINI_API_KEY=
# Local/Self-hosted Ollama (if using private host model)
OLLAMA_HOST=http://host.docker.internal:11434

# ─── 3. SHARED PERSISTENCE (PostgreSQL 17 + pgvector & Redis 7) ──────────────
POSTGRES_USER=oenexa_admin
POSTGRES_PASSWORD=replace_with_strong_production_password_here
POSTGRES_DB=oenexa_prod
REDIS_PASSWORD=replace_with_strong_redis_password_here

# ─── 4. BLOCKCHAIN LAYER-1 NODE (oenexa-node) ────────────────────────────────
ONXC_PASSWORD=replace_with_strong_chain_validator_key_password
ONXC_NETWORK=mainnet
ONXC_RPC_PORT=8545
ONXC_P2P_PORT=8765

# ─── 5. COMMERCE & ESCROW GATEWAY (oengo-api) ────────────────────────────────
JWT_SECRET=replace_with_256bit_hex_jwt_secret_key_here
SEPA_ESCROW_SETTLEMENT_ENABLED=true
