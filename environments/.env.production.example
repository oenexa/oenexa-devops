# ==============================================================================
# OENEXA Unified Ecosystem — Production VPS (62.210.92.60) Environment Template
# Database-per-Service Architecture: Dedicated Credentials per Microservice
# ==============================================================================

# ─── DOMAIN CONFIGURATION ──────────────────────────────────────────────────
DOMAIN=oenexa.com
TLS_EMAIL=admin@oenexa.com

# ─── 1. DEDICATED AI CORE PERSISTENCE (pgvector PostgreSQL 17 + Redis 7) ────
OENEXA_AI_DB_USER=oenexa_ai_prod_admin
OENEXA_AI_DB_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_FOR_AI_DB
OENEXA_AI_DB_NAME=oenexa_ai_prod

# ─── 2. DEDICATED OENGO COMMERCE PERSISTENCE (PostgreSQL 16) ────────────────
OENGO_DB_USER=oengo_commerce_prod_admin
OENGO_DB_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_FOR_OENGO_DB
OENGO_DB_NAME=oengo_commerce_prod

# ─── 3. LAYER-1 BLOCKCHAIN DAEMON (LevelDB Isolated Node) ───────────────────
ONXC_PASSWORD=STRONG_PRODUCTION_KEYSTORE_PASSWORD
ONXC_CHAIN_ID=1984

# ─── 4. PRODUCTION AI SWARM & LLM PROVIDER API KEYS ─────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434

# ─── 5. JWT & PRODUCTION SECURITY TOKENS ───────────────────────────────────
JWT_SECRET=GENERATE_64_CHAR_HEX_TOKEN_FOR_PRODUCTION_JWT_SECRET
