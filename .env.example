# ==============================================================================
# OENEXA Unified Ecosystem — Local Development Environment Template
# Database-per-Service Architecture: Dedicated Credentials per Microservice
# ==============================================================================

# ─── DOMAIN CONFIGURATION ──────────────────────────────────────────────────
DOMAIN=localhost

# ─── 1. DEDICATED AI CORE PERSISTENCE (pgvector PostgreSQL 17 + Redis 7) ────
OENEXA_AI_DB_USER=oenexa_ai_admin
OENEXA_AI_DB_PASSWORD=oenexa_ai_secret_pass
OENEXA_AI_DB_NAME=oenexa_ai_db
OENEXA_AI_REDIS_PORT=6379

# ─── 2. DEDICATED OENGO COMMERCE PERSISTENCE (PostgreSQL 16) ────────────────
OENGO_DB_USER=oengo_admin
OENGO_DB_PASSWORD=oengo_secret_pass
OENGO_DB_NAME=oengo_commerce_db

# ─── 3. LAYER-1 BLOCKCHAIN DAEMON (LevelDB Isolated Node) ───────────────────
ONXC_PASSWORD=devnet_secure_node_password
ONXC_CHAIN_ID=1984
ONXC_RPC_PORT=8545
ONXC_P2P_PORT=8765

# ─── 4. AI SWARM & LLM PROVIDER API KEYS ───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434

# ─── 5. JWT & SECURITY TOKENS ──────────────────────────────────────────────
JWT_SECRET=dev_jwt_secret_token_at_least_32_characters_long_for_security
